# Dockerfile.sandbox-python
# Ephemeral execution sandbox for TestPulse Component 1.
#
# PURPOSE:
#   Run AI-generated pytest suites against a client FastAPI/SQLite application
#   in a completely isolated, network-disabled, resource-capped container.
#
# CONSTRAINTS enforced by the launcher (docker_runner.py):
#   --memory="2048m" --memory-swap="2048m" --cpus="2.0" --network="none" --rm
#
# PRE-BAKED DEPENDENCIES:
#   All target-stack packages are pre-installed so client apps never hit
#   ModuleNotFoundError when the sandbox runs with --network=none.

FROM python:3.11-slim

# Prevent .pyc files and enable unbuffered stdout for real-time log capture
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system-level build tools needed by some Python extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Pre-install the full target FastAPI/SQLite stack so --network=none never
# triggers ModuleNotFoundError during client app imports
RUN pip install \
    # Web framework
    fastapi==0.115.0 \
    uvicorn[standard]==0.30.6 \
    # Data validation
    pydantic==2.7.4 \
    pydantic-settings==2.3.4 \
    # Database
    sqlalchemy==2.0.31 \
    aiosqlite==0.20.0 \
    sqlmodel==0.0.21 \
    # Test client
    httpx==0.27.0 \
    # Testing framework
    pytest==8.3.2 \
    pytest-cov==5.0.0 \
    pytest-asyncio==0.23.8 \
    anyio==4.4.0

# Working directory — will be bind-mounted with:
#   /workspace: client repo snapshot (read-only :ro)
#   /tests:     generated test files (read-write :rw)
WORKDIR /sandbox

# Default pytest entrypoint.
# The launcher overrides this command with:
#   pytest /tests/ --cov=/workspace --cov-report=xml:/tests/coverage.xml -v
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["--help"]
