# ============================================================
# TestPulse — Environment Configuration Template
# Copy to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# OpenRouter API (LLM Gateway)
# ------------------------------------------------------------
# Your OpenRouter API key (https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-...

# Comma-separated priority list for complex tasks:
# Planner, complex Writer, RCA synthesis
TESTPULSE_TIER1_MODELS=nvidia/nemotron-3-ultra:free,poolside/laguna-s-2.1:free,meta-llama/llama-3.3-70b-instruct:free

# Comma-separated priority list for fast utility tasks:
# Triage classification, AST formatting, error extraction, simple synthesis
TESTPULSE_TIER2_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4:free,gpt-oss-120b:free

# LLM request settings
TESTPULSE_LLM_MAX_RETRIES=3
TESTPULSE_LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# Embedding Configuration (Remote API — Zero Host RAM)
# ------------------------------------------------------------
# Remote embedding model slug (OpenRouter / OpenAI-compatible)
# e.g., "openai/text-embedding-3-small", "voyage/voyage-code-2"
TESTPULSE_EMBEDDING_MODEL=openai/text-embedding-3-small

# API key for the embedding endpoint (may reuse OPENROUTER_API_KEY
# or be a separate key, e.g. OpenAI key for embeddings)
TESTPULSE_EMBEDDING_API_KEY=sk-...

# Base URL for embedding API (leave blank to use OpenRouter default)
# TESTPULSE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Embedding batch size (number of chunks per API call)
TESTPULSE_EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------
# TestPulse Core Configuration
# ------------------------------------------------------------
# Host and port for the FastAPI dashboard/REST API
TESTPULSE_HOST=127.0.0.1
TESTPULSE_PORT=8000

# Internal workspace directory for snapshots, DB, and vector store
TESTPULSE_WORKSPACE_DIR=.testpulse

# SQLite database path (relative to workspace)
TESTPULSE_DB_PATH=.testpulse/testpulse.db

# Qdrant local storage path (relative to workspace)
TESTPULSE_QDRANT_PATH=.testpulse/qdrant

# ------------------------------------------------------------
# Test Pipeline Configuration
# ------------------------------------------------------------
# Default maximum targets per phase per run (quota-aware)
TESTPULSE_MAX_TARGETS=5

# Maximum repair attempts per generated test (Problem A loop)
TESTPULSE_MAX_REPAIR_RETRIES=3

# Sandbox execution timeout (seconds)
TESTPULSE_SANDBOX_TIMEOUT_SECONDS=30

# Sandbox memory limit
TESTPULSE_SANDBOX_MEMORY_LIMIT=2048m

# ------------------------------------------------------------
# MCP Server Configuration
# ------------------------------------------------------------
# MCP transport mode: "stdio" (default for coding agent integration)
TESTPULSE_MCP_TRANSPORT=stdio

# ------------------------------------------------------------
# Development / Debug
# ------------------------------------------------------------
# Set to "development" for verbose logging, "production" for JSON-only
TESTPULSE_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
TESTPULSE_LOG_LEVEL=INFO
